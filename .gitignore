data/HAM10000_images_part_1/
data/HAM10000_images_part_2/
data/processed/
data/hmnist_28_28_L.csv
data/hmnist_28_28_RGB.csv
data/hmnist_8_8_L.csv
data/hmnist_8_8_RGB.csv
data/ham_test.csv
