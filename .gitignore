# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- Virtual environment ---
.venv/
venv/
env/

# --- Large model artifacts (regenerable, kept on external HDD) ---
models/ruralmed_merged_fp16/
*.gguf
*.bin
models/ruralmed_adapter/*.safetensors
