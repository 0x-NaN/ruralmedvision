# --- Hugging Face cache (should never be inside project anyway) ---
.cache/
huggingface_cache/

# --- Local config (use config.example.yaml as template) ---
configs/config.yaml

# --- Personal scratch files ---
notes.txt
blank_ablation_patch.jpg

# --- OS / Editor junk ---
.DS_Store
Thumbs.db
.vscode/
*.swp

# --- Logs / temp ---
*.tmp

